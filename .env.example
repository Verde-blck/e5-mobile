# Copy to .env (git-ignored) and adjust. EXPO_PUBLIC_ values are inlined into
# the app bundle at build time, so never put a secret in here.

# The Spring Boot API on Railway, including the /api prefix. On the web
# dashboard that prefix is added by the vercel.json rewrite; a phone has no
# rewrite, so it goes straight to the backend.
EXPO_PUBLIC_API_BASE_URL=https://e5energy-production.up.railway.app/api

# true = run entirely on built-in sample data, no backend needed.
# Mock sign-ins: ADM-001 (admin), OP-014 (restricted), MFA-001 (2FA, code 123456).
EXPO_PUBLIC_USE_MOCKS=false

# Map tiles. Leave these alone for development. For production use, set a tile URL from a
# provider E5 has an account with ({z}/{x}/{y} placeholders), and its required attribution.
# The default is OpenStreetMap's public server, which is only meant for light use.
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Push alerts for a locked tablet. Leave false until Cypher's push endpoints are live and
# google-services.json is in place (docs/PUSH_SETUP.md).
EXPO_PUBLIC_PUSH_ENABLED=false

# Voice messages to several helmets. Leave false until the request is checked (docs/GROUP_CALL.md).
EXPO_PUBLIC_BROADCAST_ENABLED=false

# Live view, the live wall and calls with a helmet. Leave false until tried with a real helmet (docs/CALLS.md).
# true, True, 1, yes and on all count as on. After changing this, restart with: npx expo start --clear
EXPO_PUBLIC_LIVE_ENABLED=false
