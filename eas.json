{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://e5energy-production.up.railway.app/api",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://e5energy-production.up.railway.app/api",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_LIVE_ENABLED": "true",
        "EXPO_PUBLIC_PUSH_ENABLED": "true"
      },
      "environment": "production"
    },
    "live": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_LIVE_ENABLED": "true"
      },
      "environment": "preview"
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://e5energy-production.up.railway.app/api",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_LIVE_ENABLED": "true"
      },
      "environment": "preview"
    },
    "ios-simulator-sample": {
      "extends": "ios-simulator",
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "true",
        "EXPO_PUBLIC_LIVE_ENABLED": "true"
      },
      "environment": "preview"
    },
    "ios-testflight-iphone": {
      "extends": "production",
      "env": {
        "E5_IOS_TABLET_ONLY": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "companyName": "E5 Energy Services Limited",
        "appName": "E5 Smart Helmet",
        "sku": "e5-smart-helmet-ipad",
        "language": "en-GB"
      }
    }
  }
}
